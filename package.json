{
  "name": "eauto-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Empresa agéntica de comercio dirigida desde Android, con evidencia, aprobación humana y ejecución verificable",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build -w @eauto/mobile",
    "typecheck": "tsc -b packages/domain packages/agent-kernel packages/application packages/content packages/infrastructure apps/api && npm run typecheck -w @eauto/mobile",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build",
    "dev:api": "npm run dev -w @eauto/api",
    "dev:worker": "npm run dev:worker -w @eauto/api",
    "dev:mobile": "npm run start -w @eauto/mobile",
    "credentials:generate": "node scripts/generate-internal-secrets.mjs",
    "credentials:doctor": "node scripts/credentials-doctor.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:parity": "node scripts/capability-parity-doctor.mjs",
    "doctor:production": "node scripts/production-check.mjs",
    "migrate": "node scripts/migrate.mjs",
    "build:server": "tsc -b packages/domain packages/agent-kernel packages/application packages/content packages/infrastructure apps/api",
    "smoke:core": "node scripts/smoke-core.mjs",
    "smoke:credentials": "node scripts/smoke-credentials.mjs",
    "smoke:object-storage": "node scripts/smoke-object-storage.mjs",
    "smoke:production-runtime": "node scripts/smoke-production-runtime.mjs",
    "smoke:postgres-schema": "node scripts/smoke-postgres-schema.mjs",
    "smoke:taxonomy-postgres": "node scripts/smoke-mercadolibre-taxonomy-postgres.mjs",
    "smoke:mercadolibre-question-answer": "node scripts/smoke-mercadolibre-question-answer-contract.mjs",
    "smoke:mercadolibre-product-ads": "node scripts/smoke-mercadolibre-product-ads-postgres.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.30",
    "eslint": "^10.8.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4"
  }
}
