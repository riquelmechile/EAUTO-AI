{
  "schemaVersion": "eauto-credential-requirements-v1",
  "groups": [
    {
      "id": "deployment",
      "description": "Dominios, artefactos y distribución Android",
      "variables": [
        { "name": "API_DOMAIN", "source": "external", "validator": "hostname" },
        { "name": "S3_DOMAIN", "source": "external", "validator": "hostname" },
        { "name": "EXPO_PUBLIC_API_URL", "source": "external", "validator": "https-url" },
        { "name": "EAS_PROJECT_ID", "source": "external", "validator": "uuid" },
        { "name": "EAUTO_IMAGE", "source": "external", "validator": "immutable-image" }
      ]
    },
    {
      "id": "postgres",
      "description": "Base autoritativa",
      "variables": [
        { "name": "POSTGRES_PASSWORD", "source": "generated", "validator": "strong-secret" },
        { "name": "DATABASE_URL", "source": "generated", "validator": "postgres-url" }
      ]
    },
    {
      "id": "identity",
      "description": "Enrolamiento de operadores",
      "variables": [
        {
          "name": "OPERATOR_TOKENS_JSON",
          "source": "generated",
          "validator": "operator-identities"
        }
      ]
    },
    {
      "id": "object-storage",
      "description": "MinIO privado",
      "variables": [
        { "name": "MINIO_ROOT_USER", "source": "generated", "validator": "non-placeholder" },
        { "name": "MINIO_ROOT_PASSWORD", "source": "generated", "validator": "strong-secret" },
        {
          "name": "OBJECT_STORAGE_ACCESS_KEY",
          "source": "generated",
          "validator": "non-placeholder"
        },
        { "name": "OBJECT_STORAGE_SECRET_KEY", "source": "generated", "validator": "strong-secret" }
      ]
    },
    {
      "id": "intelligence",
      "description": "Proveedor LLM shadow",
      "variables": [
        { "name": "LLM_BASE_URL", "source": "external", "validator": "https-url" },
        { "name": "LLM_API_KEY", "source": "external", "validator": "non-placeholder" }
      ]
    },
    {
      "id": "content",
      "description": "Imagen, video, fingerprint y catálogos",
      "variables": [
        { "name": "CONTENT_PROVIDER_URL", "source": "external", "validator": "https-url" },
        {
          "name": "CONTENT_PROVIDER_API_KEY",
          "source": "external",
          "validator": "non-placeholder"
        },
        { "name": "CATALOG_VISUAL_PROVIDER_URL", "source": "external", "validator": "https-url" },
        {
          "name": "CATALOG_VISUAL_PROVIDER_API_KEY",
          "source": "external",
          "validator": "non-placeholder"
        },
        {
          "name": "PRODUCT_FINGERPRINT_PROVIDER_URL",
          "source": "external",
          "validator": "https-url"
        },
        {
          "name": "PRODUCT_FINGERPRINT_PROVIDER_API_KEY",
          "source": "external",
          "validator": "non-placeholder"
        },
        {
          "name": "CATALOG_SUPPLIER_ROUTES_JSON",
          "source": "external",
          "validator": "https-route-map"
        },
        { "name": "CATALOG_SUPPLIER_API_KEY", "source": "external", "validator": "non-placeholder" }
      ]
    },
    {
      "id": "mercadolibre",
      "description": "MercadoLibre Chile Plasticov y Maustian",
      "variables": [
        { "name": "MELI_CLIENT_ID", "source": "external", "validator": "numeric-id" },
        { "name": "MELI_CLIENT_SECRET", "source": "external", "validator": "non-placeholder" },
        { "name": "MELI_REDIRECT_URI", "source": "external", "validator": "https-url" },
        { "name": "MELI_TOKEN_VAULT_KEY_BASE64", "source": "generated", "validator": "base64-32" },
        { "name": "MELI_PLASTICOV_SELLER_ID", "source": "external", "validator": "numeric-id" },
        { "name": "MELI_MAUSTIAN_SELLER_ID", "source": "external", "validator": "numeric-id" },
        { "name": "MELI_APPLICATION_ID", "source": "external", "validator": "numeric-id" },
        { "name": "MELI_WEBHOOK_TOKEN", "source": "generated", "validator": "strong-secret" },
        {
          "name": "MELI_PRODUCT_ADS_ADVERTISER_IDS_JSON",
          "source": "external-discovery",
          "validator": "advertiser-map"
        }
      ]
    },
    {
      "id": "backup",
      "description": "Repositorio Restic externo",
      "variables": [
        { "name": "RESTIC_REPOSITORY", "source": "external", "validator": "non-placeholder" },
        { "name": "RESTIC_PASSWORD", "source": "generated", "validator": "strong-secret" },
        {
          "name": "RESTIC_AWS_ACCESS_KEY_ID",
          "source": "external",
          "validator": "non-placeholder"
        },
        {
          "name": "RESTIC_AWS_SECRET_ACCESS_KEY",
          "source": "external",
          "validator": "non-placeholder"
        }
      ]
    }
  ]
}
