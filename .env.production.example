# Public hosts — replace with the real DNS records before deployment
API_DOMAIN=api.example.cl
S3_DOMAIN=files.example.cl
ACME_EMAIL=operations@example.cl
EXPO_PUBLIC_API_URL=https://api.example.cl
EAS_PROJECT_ID=__REQUIRED__

# Immutable runtime artifact published by the release workflow.
# Use the GHCR digest, never latest or a mutable tag.
EAUTO_IMAGE=ghcr.io/riquelmechile/eauto-ai@sha256:__REQUIRED__

# Runtime
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://app.example.cl
AUTH_MODE=static-token
AGENT_MANUAL_CONTROL_ENABLED=false
OPERATOR_TOKENS_JSON=__REQUIRED__
SESSION_ACCESS_TTL_MS=900000
SESSION_REFRESH_TTL_MS=2592000000

# PostgreSQL
POSTGRES_DB=eauto
POSTGRES_USER=eauto
POSTGRES_PASSWORD=__REQUIRED__
# Percent-encode reserved characters in the password component of DATABASE_URL.
DATABASE_URL=postgres://eauto:__REQUIRED__@postgres:5432/eauto

# Object storage
MINIO_ROOT_USER=__REQUIRED__
MINIO_ROOT_PASSWORD=__REQUIRED__
OBJECT_STORAGE_BUCKET=eauto-content
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://files.example.cl
OBJECT_STORAGE_INTERNAL_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=__REQUIRED__
OBJECT_STORAGE_SECRET_KEY=__REQUIRED__
OBJECT_STORAGE_FORCE_PATH_STYLE=true
SOURCE_IMAGE_MAX_BYTES=10000000
SOURCE_IMAGE_UPLOAD_TTL_SECONDS=300

# Concrete Creative Studio: MiniMax image/video generation.
# CONTENT_PROVIDER_API_KEY is used as the MiniMax key; MINIMAX_API_KEY may override it.
CONTENT_GENERATION_ENABLED=false
CONTENT_PROVIDER_KIND=minimax
CONTENT_PROVIDER_URL=https://api.minimax.io/v1/image_generation
CONTENT_PROVIDER_API_KEY=__REQUIRED__
CONTENT_PROVIDER_NAME=minimax
CONTENT_PROVIDER_TIMEOUT_MS=120000
CONTENT_PROVIDER_MAX_RESPONSE_BYTES=2000000
CONTENT_MAX_ASSET_BYTES=100000000
MINIMAX_API_KEY=
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-2.3
MINIMAX_GENERATE_VIDEO=false
MINIMAX_PROMPT_VERSION=eauto-commerce-v1
MINIMAX_POLL_INTERVAL_MS=5000
MINIMAX_MAXIMUM_POLLS=120

# Photo-to-Similar and allowlisted supplier catalogs
CATALOG_ACQUISITION_ENABLED=true
CATALOG_VISUAL_PROVIDER_URL=https://catalog.example.cl/v1/photo-similarity
CATALOG_VISUAL_PROVIDER_API_KEY=__REQUIRED__
CATALOG_VISUAL_PROVIDER_NAME=production-visual-search
PRODUCT_FINGERPRINT_PROVIDER_URL=https://catalog.example.cl/v1/product-fingerprint
PRODUCT_FINGERPRINT_PROVIDER_API_KEY=__REQUIRED__
PRODUCT_FINGERPRINT_PROVIDER_NAME=production-perceptual-fingerprint
PRODUCT_FINGERPRINT_PROVIDER_VERSION=phash-64-v1
PRODUCT_FINGERPRINT_TIMEOUT_MS=30000
PRODUCT_FINGERPRINT_MAX_RESPONSE_BYTES=64000
CATALOG_SUPPLIER_ROUTES_JSON={"supplier-production":"https://catalog.example.cl/v1/suppliers/production/search"}
CATALOG_SUPPLIER_API_KEY=__REQUIRED__
CATALOG_SUPPLIER_PROVIDER_NAME=production-supplier-catalog
CATALOG_PROVIDER_TIMEOUT_MS=30000
CATALOG_PROVIDER_MAX_RESPONSE_BYTES=2000000
CATALOG_MINIMUM_SIMILARITY_BPS=8000
CATALOG_MAXIMUM_EVIDENCE_AGE_MS=3600000
CATALOG_POLICY_VERSION=catalog-acquisition-v1

# Generic external action gateway. MercadoLibre action kinds are forbidden here.
# Keep disabled until a non-MercadoLibre capability has its own policy and live gate.
ACTION_EXECUTION_ENABLED=false
ACTION_PROVIDER_API_KEY=
ACTION_PROVIDER_NAME=production-action-gateway
ACTION_PROVIDER_TIMEOUT_MS=30000
ACTION_PROVIDER_MAX_RESPONSE_BYTES=2000000
ACTION_PROVIDER_ROUTES_JSON={}
ACTION_POLICY_VERSION=company-policy-v1
ACTION_APPROVAL_TTL_MS=3600000

# Durable jobs
OUTBOX_WORKER_ID=eauto-outbox-production
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BASE_RETRY_MS=1000
OUTBOX_MAX_RETRY_MS=300000

# DeepSeek shadow intelligence
LLM_ENABLED=true
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=__REQUIRED__
LLM_TIMEOUT_MS=90000
LLM_DEFAULT_MAXIMUM_PROMPT_TOKENS=100000
LLM_DEFAULT_MAXIMUM_OUTPUT_TOKENS=8000
LLM_DAILY_ACCOUNT_BUDGET_MICROS_USD=1000000
INTELLIGENCE_WORKER_ENABLED=true
INTELLIGENCE_WORKER_ID=eauto-intelligence-production
INTELLIGENCE_POLL_INTERVAL_MS=2000
INTELLIGENCE_BATCH_SIZE=10
INTELLIGENCE_LEASE_MS=60000
INTELLIGENCE_MAX_ATTEMPTS=5
INTELLIGENCE_RETRY_BASE_MS=5000
INTELLIGENCE_RETRY_MAX_MS=900000
INTELLIGENCE_SESSION_DEADLINE_MS=900000
INTELLIGENCE_DEFAULT_EVIDENCE_MAX_AGE_MS=900000
INTELLIGENCE_DEFAULT_BUDGET_MICROS_USD=50000
INTELLIGENCE_DEFAULT_BUDGET_MINOR_CLP=0

# Durable collaboration, Evidence Router, semantic memory, Account Brain and 16 daemons.
# First production rollout remains Plasticov-only.
COMPANY_INTELLIGENCE_ENABLED=true
COMPANY_INTELLIGENCE_WORKER_ID=eauto-company-intelligence-production
COMPANY_INTELLIGENCE_POLL_INTERVAL_MS=2000
COMPANY_INTELLIGENCE_BATCH_SIZE=20
COMPANY_INTELLIGENCE_LEASE_MS=60000
COMPANY_INTELLIGENCE_MAX_ATTEMPTS=5
COMPANY_INTELLIGENCE_MAX_EVIDENCE_AGE_MS=900000
COMPANY_INTELLIGENCE_ACCOUNT_IDS=plasticov

# MercadoLibre Chile read plane
MELI_ENABLED=true
MELI_CLIENT_ID=__REQUIRED__
MELI_CLIENT_SECRET=__REQUIRED__
MELI_REDIRECT_URI=https://api.example.cl/v1/integrations/mercadolibre/oauth/callback
MELI_AUTHORIZATION_URL=https://auth.mercadolibre.cl/authorization
MELI_TOKEN_URL=https://api.mercadolibre.com/oauth/token
MELI_API_BASE_URL=https://api.mercadolibre.com
MELI_TOKEN_VAULT_KEY_BASE64=__REQUIRED__
MELI_PLASTICOV_SELLER_ID=__REQUIRED__
MELI_MAUSTIAN_SELLER_ID=__REQUIRED__
MELI_OAUTH_STATE_TTL_MS=600000
MELI_REFRESH_WINDOW_MS=300000
MELI_REFRESH_LEASE_MS=30000
MELI_HTTP_TIMEOUT_MS=15000
MELI_MAXIMUM_SCAN_PAGES=100

# MercadoLibre Product Ads v2 read plane. Sync requires an explicit date range.
MELI_PRODUCT_ADS_ENABLED=true
MELI_PRODUCT_ADS_ACCOUNT_ID=plasticov
# Leave empty to auto-select only when exactly one MLC advertiser is visible.
MELI_PRODUCT_ADS_ADVERTISER_IDS_JSON={}
MELI_PRODUCT_ADS_TIMEOUT_MS=30000
MELI_PRODUCT_ADS_MAX_RESPONSE_BYTES=2000000
MELI_PRODUCT_ADS_MAXIMUM_RANGE_DAYS=90

# First and only scoped MercadoLibre write. Enable only after issue #41 live gates.
MELI_QUESTION_ANSWER_ENABLED=false
MELI_QUESTION_ANSWER_ACCOUNT_ID=
MELI_QUESTION_ANSWER_POLICY_VERSION=mercadolibre-question-answer-v1
MELI_QUESTION_ANSWER_TIMEOUT_MS=15000
MELI_QUESTION_ANSWER_MAX_RESPONSE_BYTES=100000

MELI_WEBHOOK_ENABLED=true
MELI_APPLICATION_ID=__REQUIRED__
MELI_WEBHOOK_TOKEN=__REQUIRED__
MELI_NOTIFICATION_WORKER_ID=eauto-meli-notifications-production
MELI_NOTIFICATION_POLL_INTERVAL_MS=1000
MELI_NOTIFICATION_BATCH_SIZE=100
MELI_NOTIFICATION_LEASE_MS=30000
MELI_NOTIFICATION_MAX_ATTEMPTS=8
MELI_NOTIFICATION_BASE_RETRY_MS=1000
MELI_NOTIFICATION_MAX_RETRY_MS=300000

# External encrypted backup repository
RESTIC_REPOSITORY=__REQUIRED__
RESTIC_PASSWORD=__REQUIRED__
RESTIC_AWS_ACCESS_KEY_ID=__REQUIRED__
RESTIC_AWS_SECRET_ACCESS_KEY=__REQUIRED__
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
BACKUP_CHECK_SUBSET=1/20
