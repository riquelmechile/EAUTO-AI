# Public hosts — replace with the real DNS records before deployment
API_DOMAIN=api.example.cl
S3_DOMAIN=files.example.cl
ACME_EMAIL=operations@example.cl
EXPO_PUBLIC_API_URL=https://api.example.cl
EAS_PROJECT_ID=__REQUIRED__

# Runtime
NODE_ENV=production
PORT=3000
AUTH_MODE=tokens
OPERATOR_TOKENS_JSON=__REQUIRED__
SESSION_ACCESS_TTL_MS=900000
SESSION_REFRESH_TTL_MS=2592000000

# PostgreSQL and Redis
POSTGRES_DB=eauto
POSTGRES_USER=eauto
POSTGRES_PASSWORD=__REQUIRED__
REDIS_PASSWORD=__REQUIRED__
DATABASE_URL=postgres://eauto:__REQUIRED__@postgres:5432/eauto
REDIS_URL=redis://:__REQUIRED__@redis:6379

# Object storage
MINIO_ROOT_USER=__REQUIRED__
MINIO_ROOT_PASSWORD=__REQUIRED__
OBJECT_STORAGE_BUCKET=eauto-content
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://files.example.cl
OBJECT_STORAGE_INTERNAL_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=__REQUIRED__
OBJECT_STORAGE_SECRET_KEY=__REQUIRED__
OBJECT_STORAGE_FORCE_PATH_STYLE=true
SOURCE_IMAGE_MAX_BYTES=10000000
SOURCE_IMAGE_UPLOAD_TTL_SECONDS=300

# Durable jobs
OUTBOX_WORKER_ID=eauto-outbox-production
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BASE_RETRY_MS=1000
OUTBOX_MAX_RETRY_MS=300000

# DeepSeek shadow intelligence
LLM_ENABLED=true
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=__REQUIRED__
LLM_TIMEOUT_MS=90000
LLM_DEFAULT_MAXIMUM_PROMPT_TOKENS=100000
LLM_DEFAULT_MAXIMUM_OUTPUT_TOKENS=8000
LLM_DAILY_ACCOUNT_BUDGET_MICROS_USD=1000000
INTELLIGENCE_WORKER_ENABLED=true
INTELLIGENCE_WORKER_ID=eauto-intelligence-production
INTELLIGENCE_POLL_INTERVAL_MS=2000
INTELLIGENCE_BATCH_SIZE=10
INTELLIGENCE_LEASE_MS=60000
INTELLIGENCE_MAX_ATTEMPTS=5
INTELLIGENCE_RETRY_BASE_MS=5000
INTELLIGENCE_RETRY_MAX_MS=900000
INTELLIGENCE_SESSION_DEADLINE_MS=900000
INTELLIGENCE_DEFAULT_EVIDENCE_MAX_AGE_MS=900000
INTELLIGENCE_DEFAULT_BUDGET_MICROS_USD=50000
INTELLIGENCE_DEFAULT_BUDGET_MINOR_CLP=0

# MercadoLibre Chile
MELI_ENABLED=true
MELI_CLIENT_ID=__REQUIRED__
MELI_CLIENT_SECRET=__REQUIRED__
MELI_REDIRECT_URI=https://api.example.cl/v1/integrations/mercadolibre/oauth/callback
MELI_AUTHORIZATION_URL=https://auth.mercadolibre.cl/authorization
MELI_TOKEN_URL=https://api.mercadolibre.com/oauth/token
MELI_API_BASE_URL=https://api.mercadolibre.com
MELI_TOKEN_VAULT_KEY_BASE64=__REQUIRED__
MELI_PLASTICOV_SELLER_ID=__REQUIRED__
MELI_MAUSTIAN_SELLER_ID=__REQUIRED__
MELI_OAUTH_STATE_TTL_MS=600000
MELI_REFRESH_WINDOW_MS=300000
MELI_REFRESH_LEASE_MS=30000
MELI_HTTP_TIMEOUT_MS=15000
MELI_MAXIMUM_SCAN_PAGES=100
MELI_WEBHOOK_ENABLED=true
MELI_APPLICATION_ID=__REQUIRED__
MELI_NOTIFICATION_WORKER_ID=eauto-meli-notifications-production
MELI_NOTIFICATION_POLL_INTERVAL_MS=1000
MELI_NOTIFICATION_BATCH_SIZE=100
MELI_NOTIFICATION_LEASE_MS=30000
MELI_NOTIFICATION_MAX_ATTEMPTS=8
MELI_NOTIFICATION_BASE_RETRY_MS=1000
MELI_NOTIFICATION_MAX_RETRY_MS=300000

# External encrypted backup repository
RESTIC_REPOSITORY=__REQUIRED__
RESTIC_PASSWORD=__REQUIRED__
RESTIC_AWS_ACCESS_KEY_ID=__REQUIRED__
RESTIC_AWS_SECRET_ACCESS_KEY=__REQUIRED__
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
BACKUP_CHECK_SUBSET=1/20
