{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.16.0"
    },
    "preview": {
      "distribution": "internal",
      "node": "22.16.0",
      "android": {
        "buildType": "apk",
        "image": "latest"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.16.0",
      "channel": "production",
      "android": {
        "buildType": "app-bundle",
        "image": "latest"
      }
    }
  }
}
