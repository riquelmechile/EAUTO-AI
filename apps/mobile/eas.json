{
  "cli": {
    "version": "21.2.0",
    "requireCommit": true,
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.16.0"
    },
    "preview": {
      "distribution": "internal",
      "node": "22.16.0",
      "android": {
        "buildType": "apk",
        "image": "auto"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.16.0",
      "channel": "production",
      "android": {
        "buildType": "app-bundle",
        "image": "auto"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
